# ── Python ────────────────────────────────────────────────
# Bytecode cache — auto-generated by Python, never commit these
__pycache__/
*.py[cod]

# Virtual environment — contains thousands of files, all machine-specific
venv/
.venv/
env/

# Distribution / packaging artifacts
*.egg-info/
dist/
build/

# ── Environment & Secrets ─────────────────────────────────
# API keys, DB passwords — NEVER commit these
.env
.env.*

# ── Jupyter Notebooks ─────────────────────────────────────
# Checkpoint files auto-saved by Jupyter — not part of the actual code
.ipynb_checkpoints/

# ── macOS ─────────────────────────────────────────────────
# macOS puts these invisible files in every folder you open in Finder
.DS_Store

# ── VS Code ───────────────────────────────────────────────
# Editor settings that are personal to your machine
.vscode/

# ── ML Artifacts (optional — read note below) ─────────────
# Uncomment these if your .pkl files are too large for GitHub (>100MB)
# *.pkl
# *.pkl.gz